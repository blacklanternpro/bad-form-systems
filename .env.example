# Server-only. Never expose GEMINI_API_KEY to the browser.
GEMINI_API_KEY=

# Contact delivery. Resend + CONTACT_TO_EMAIL sends mail.
# Without Resend, the form returns a mailto: fallback using NEXT_PUBLIC_CONTACT_EMAIL.
CONTACT_TO_EMAIL=
NEXT_PUBLIC_CONTACT_EMAIL=
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
